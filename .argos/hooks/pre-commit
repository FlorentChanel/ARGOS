#!/bin/bash

# Select the CLI entrypoint: argos.exe on Windows, the python symlink elsewhere.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) ARGOS_CLI="./argos.exe" ;;
    *) ARGOS_CLI="python argos.py" ;;
esac

remote_url=$(git remote get-url origin)

# Authoring repo (<owner>/ARGOS-Profs): validate the bank structure when the
# bank or the unit tests are part of the commit.
if [[ "$remote_url" =~ [/:]ARGOS-Profs(\.git)?$ ]]; then
    if git diff --cached --name-only | grep -qE '^\.argos-config\.json$'; then
        echo "ERROR: .argos-config.json is local student state and must not be committed to ARGOS-Profs."
        exit 1
    fi
    if git diff --cached --name-only | grep -qE '^\.argos/(exercises|unitTests)/'; then
        echo "Bank changes detected, validating exercise structure..."
        $ARGOS_CLI admin check-structure
        exit $?
    fi
    exit 0
fi

# Solution detection only guards the student repo (<owner>/ARGOS and its forks).
# Anchored so that ARGOS-Profs does not match.
if [[ ! "$remote_url" =~ [/:]ARGOS(\.git)?$ ]]; then
    exit 0
fi

# The upstream student repo (HE-Arc/ARGOS) only receives 'argos admin publish'
# outputs: refuse local working state there. On student forks (<login>/ARGOS),
# committing Exercises/ is precisely the point — no restriction.
if [[ "$remote_url" =~ [/:]HE-Arc/ARGOS(\.git)?$ ]]; then
    # Deletions stay allowed: removing local state from tracking is maintenance.
    forbidden=$(git diff --cached --name-status | awk '$1 != "D" { print $2 }' \
        | grep -E '^(Exercises/|\.argos-config\.json$)')
    if [ -n "$forbidden" ]; then
        echo "ERROR: this clone is the upstream student repository (HE-Arc/ARGOS)."
        echo "It only receives 'argos admin publish' outputs; refusing to commit local working state:"
        echo "$forbidden" | sed 's/^/  /'
        exit 1
    fi
fi

exercises=$(git diff --cached --name-only \
      | grep '^.argos/exercises/' \
      | awk -F'/' '{print $3}' \
      | sort -u \
      | tr '\n' ',' \
      | sed 's/,$//')

if [ -z "$exercises" ]; then
      exit 0
fi

echo "Checking for solution blocks in: $exercises"

$ARGOS_CLI admin solution detect "$exercises"
exit $?
